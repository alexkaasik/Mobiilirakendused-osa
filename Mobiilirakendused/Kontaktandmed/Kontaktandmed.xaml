<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobiilirakendused.Kontaktandmed"
             Title="Kontaktandmed">
    <VerticalStackLayout Padding="24" Spacing="8">
        <Label 
            Text="X => 3"
            VerticalOptions="Center" 
            HorizontalOptions="Center" 
            HorizontalTextAlignment="Center"
        />
        <Border 
            StrokeShape="RoundRectangle 20,20,20,20"
            HorizontalOptions="Center"
            BackgroundColor="BlueViolet"
            Padding="12"
        >
            <Picker 
                x:Name="ContactPicker" 
                Title="Pick a contact" 
                ItemsSource="{Binding Contacts}"
                ItemDisplayBinding="{Binding Name}"
                HorizontalTextAlignment="Center"
                FontSize="24"
                FontAttributes="Bold"
            />
        </Border>
        <Button Text="Call" Clicked="CallButton"/>
        <Button Text="Send SMS" Clicked="SmsSendButton"/>
        <Button Text="Send Email" Clicked="EmailSendButton"/>

        <Button Text="View contact list" Clicked="ViewContactListRedictPage"/>
    </VerticalStackLayout>
</ContentPage>