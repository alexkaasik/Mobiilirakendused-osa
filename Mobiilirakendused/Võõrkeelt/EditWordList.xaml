<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobiilirakendused.EditWordList"
             Title="EditWordList">
    <VerticalStackLayout Padding="20" Spacing="8">
        <Label
            Text="Word:" 
            FontSize="20"
        />
        <Entry 
            x:Name="WordEntry" 
            Placeholder="Enter E-mail address"
            Text="{Binding Word}"
            Keyboard="Text"
        />

        <Label
            Text="Translation:" 
            FontSize="20"
        />
        <Entry 
            x:Name="TranslationEntry"
            Placeholder="Enter Translation"
            Text="{Binding Translation}" 
            Keyboard="Text"
        />
        <Label
            Text="Explanation:" 
            FontSize="20"
        />
        <Entry 
            x:Name="ExplanationEntry"
            Placeholder="Enter Explanation"
            Text="{Binding Explanation}"
        ></Entry>

        <HorizontalStackLayout
            VerticalOptions="Center"
        >
            <Label
                Text="learning:" 
                FontSize="20"
                VerticalOptions="Center"
            />
            <CheckBox
                x:Name="LearningCheckbox"
                IsChecked="{Binding Learing}"
                VerticalOptions="Center"
            />
        </HorizontalStackLayout>

        <Button
            Text="Save"
            Clicked="OnSaveClicked"
            FontSize="20"
        />
        <Button
            Text="Cancel"
            Clicked="OnCancelClicked"
            FontSize="20"
        />
    </VerticalStackLayout>
</ContentPage>